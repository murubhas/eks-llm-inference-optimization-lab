**/*.tfstate.*
**/*.tfplan
**/*.plan.txt

# Benchmark and generated artifacts
artifacts/
results/
output/
outputs/
*.log
*.csv
*.parquet

# Models, adapters, checkpoints, and archives
models/
checkpoints/
adapters/
*.safetensors
*.bin
*.pt
*.pth
*.tar
*.tar.gz

# Language and editor caches
__pycache__/
*.py[cod]
.venv/
.venv-*/
node_modules/
.DS_Store
~$*
